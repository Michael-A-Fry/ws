#!/usr/bin/env bash
# Runs the checks CI runs, on your machine, before a push leaves it.
# Turn it on once per clone:  git config core.hooksPath .github/hooks
# Skip it for one push:       WS_SKIP_PREPUSH=1 git push
# Which tests: those the change can affect (scripts/affected_tests.py); CI runs the whole suite on every pull request
# and is required to merge. A change that maps to more than 40 test files, or touches a path that reaches every test
# (pyproject.toml, uv.lock, a conftest.py, tests/plugins/, .github/), runs a capped set instead: the smoke set, every
# changed or added test and the tests importing a changed module directly, stopped after WS_PREPUSH_CAP seconds
# (default 6 s a file, at least 300 and at most 1800; counted from when the tests start, after any wrapper; it needs
# `timeout`, which macOS lacks by default,
# so there the capped set has no cap). A capped set that hits the cap fails the push: raise WS_PREPUSH_CAP, or skip the
# hook, and CI runs the rest. Nothing mapped runs the smoke set, never zero; a selector that fails runs the smoke set
# plus the changed tests and the tests named for a changed module. The change is HEAD against origin/main, not the refs
# a push names.
# WS_PREPUSH_FULL=1 runs the whole suite here (logged like a skip).
# Run the tests through a wrapper: WS_PREPUSH_WRAP="your-lock-command --flag" git push (split on spaces; for a machine
# that queues test runs, so a push's tests don't race the others). Unset (or only spaces), the hook uses
# `ws-test --light --mem 3G --node local --` when ws-test is on PATH (6G with e2e tests or over 40 files in the set;
# `--full` for WS_PREPUSH_FULL=1): it queues for a slot, up
# to WS_TEST_WAIT (45 minutes), and caps xdist's workers, so a busy machine doesn't time the tests out. Without ws-test
# they run bare. Set but empty (WS_PREPUSH_WRAP= git push), they always run bare.
# Signatures: before any test, `git log --format='%H %G?'` over the commits being sent. An unsigned one (N) refuses the
# push, because the repository takes signed commits only and the pull request would sit blocked; one git cannot check
# (E), whose key it does not know (U) or that is signed but has no signers file to check against is a warning; a bad (B) or revoked (R) one, or a signature header git cannot read, refuses. A
# push whose commits git cannot list refuses too. Nothing is checked when CI is set (one line goes in the skip log, as for WS_SKIP_PREPUSH), and no network call is made. It reads
# the refs git gives a pre-push hook on stdin, so a new branch is checked back to what the remote already has.
# A skip is never silent: it adds a line to .git/ws-prepush-skips.log (the log of the worktree's git dir).
set -euo pipefail

top="$(git rev-parse --show-toplevel)"
cd "$top"
# git sets GIT_DIR and its kin for a hook; left in place, every `git -C <scratch repo>` a test runs would act on this
# clone's own repository instead. The tests find their repositories by folder, as they do anywhere else.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

log="$(git rev-parse --git-path ws-prepush-skips.log)"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [[ "${WS_SKIP_PREPUSH:-}" == "1" ]]; then
  printf '%s skipped pre-push on %s\n' "$stamp" "$branch" >>"$log"
  echo "pre-push: skipped because WS_SKIP_PREPUSH=1 (logged in $log)" >&2
  exit 0
fi

# the refs being pushed arrive on stdin: <local ref> <local sha> <remote ref> <remote sha>
unsigned=()
refused=()
empty_signers=""

# The status of one commit that git calls N, checked again with an empty signers file, so an ssh signature gives U or E
# (real, but unknown here) and a forged one B. N with no `gpgsig` header (in the header only: it ends at the first blank
# line) is unsigned.
recheck() {
  local sha="$1" has
  has="$(git cat-file commit "$sha" 2>/dev/null | sed '/^$/q' | grep -c '^gpgsig' || true)"
  if [[ "$has" == 0 ]]; then
    unsigned+=("$sha")
    return
  fi
  if [[ -z "$empty_signers" ]]; then
    empty_signers="$(mktemp)"
    trap 'rm -f "$empty_signers"' EXIT
  fi
  case "$(git -c "gpg.ssh.allowedSignersFile=$empty_signers" log -1 --format='%G?' "$sha" 2>/dev/null || true)" in
    U | E) echo "pre-push: warning: ${sha:0:12} is signed but git cannot check it here (no signers file?)" >&2 ;;
    *) refused+=("$sha") ;; # B, R, or N again: a header git cannot read as any signature is not one
  esac
}

# Reads `git log --format='%H %G?'` for one range. Returns 1 when git log itself fails, so the caller never takes a
# failed walk for a clean one.
check_range() {
  local out sha status
  out="$(git log --format='%H %G?' "$@" 2>/dev/null)" || return 1
  while read -r sha status; do
    [[ -z "$sha" ]] && continue
    case "$status" in
      N) recheck "$sha" ;;
      B | R) refused+=("$sha") ;;
      E | U | X | Y) echo "pre-push: warning: ${sha:0:12} has a signature git cannot check (status $status)" >&2 ;;
    esac
  done <<<"$out"
}

failed_walk=0
if [[ -n "${CI:-}" ]]; then
  printf '%s skipped the signature check on %s (CI is set)\n' "$stamp" "$branch" >>"$log"
elif [[ ! -t 0 ]]; then
  # --remotes=<name> only when $1 is a configured remote: a push by URL gets every remote-tracking ref
  remote_name="${1:-}"
  if [[ -z "$remote_name" ]] || ! git remote 2>/dev/null | grep -qxF -- "$remote_name"; then
    remote_arg="--remotes"
  else
    remote_arg="--remotes=$remote_name"
  fi
  while read -r _ local_sha _ remote_sha; do
    [[ -z "$local_sha" || "$local_sha" =~ ^0+$ ]] && continue # a delete sends no commits
    if [[ "$remote_sha" =~ ^0+$ ]]; then
      check_range "$local_sha" --not "$remote_arg" || failed_walk=1
    else
      # a remote sha this clone does not hold (the remote moved on) makes the range fail: fall back to the new-branch walk
      check_range "${remote_sha}..${local_sha}" || check_range "$local_sha" --not --remotes || failed_walk=1
    fi
  done
fi
if [[ "$failed_walk" == 1 ]]; then
  echo "pre-push: refused: git could not list the commits being pushed, so their signatures are unchecked" >&2
  echo "pre-push: fetch, then push again; or WS_SKIP_PREPUSH=1 git push (logged)" >&2
  exit 1
fi
if [[ "${#refused[@]}" != 0 ]]; then
  echo "pre-push: refused: ${#refused[@]} commit(s) being pushed have a bad or revoked signature:" >&2
  printf '  %s\n' "${refused[@]:0:10}" >&2
  exit 1
fi
if [[ "${#unsigned[@]}" != 0 ]]; then
  echo "pre-push: refused: ${#unsigned[@]} commit(s) being pushed are not signed:" >&2
  printf '  %s\n' "${unsigned[@]:0:10}" >&2
  echo "pre-push: sign them (git rebase --exec 'git commit --amend --no-edit -S' <base>), or WS_SKIP_PREPUSH=1 git push (logged)" >&2
  exit 1
fi

echo "pre-push: uvx prek run --all-files" >&2
uvx prek run --all-files >&2

wrap=()
if [[ -n "${WS_PREPUSH_WRAP:-}" ]]; then
  read -r -a wrap <<<"$WS_PREPUSH_WRAP"
fi
# unset, or only spaces, means "your machine's default": ws-test when it's on PATH. Set but empty means bare.
auto_wrap=0
if [[ "${#wrap[@]}" == 0 && (-n "${WS_PREPUSH_WRAP:-}" || -z "${WS_PREPUSH_WRAP+set}") ]] &&
  command -v ws-test >/dev/null 2>&1; then
  auto_wrap=1
fi

smoke=(tests/test_cli.py tests/test_cli_registry.py tests/test_prepush_hook.py)
suite=(uv run --locked pytest -q)
limit=()
kind="SELECT"
targets=()

if [[ "${WS_PREPUSH_FULL:-}" == "1" ]]; then
  kind="FULL"
  printf '%s full suite forced on %s (WS_PREPUSH_FULL=1)\n' "$stamp" "$branch" >>"$log"
else
  fetch=(git fetch -q origin main)
  if command -v timeout >/dev/null 2>&1; then
    fetch=(timeout 20 "${fetch[@]}")
  fi
  GIT_TERMINAL_PROMPT=0 "${fetch[@]}" 2>/dev/null || true
  picked=""
  if [[ -f scripts/affected_tests.py ]]; then
    picked="$(python3 -I scripts/affected_tests.py --base origin/main 2>/dev/null)" || picked=""
  fi
  head_line="$(head -n1 <<<"$picked")"
  case "$head_line" in
    SELECT | SMOKE | CAPPED*)
      kind="$head_line"
      # a while loop, not mapfile: macOS ships bash 3.2, which has no mapfile
      while IFS= read -r line; do
        [[ -n "$line" ]] && targets+=("$line")
      done < <(tail -n +2 <<<"$picked")
      ;;
    *)
      echo "pre-push: no usable selection (${head_line:-no selector}); running the smoke set and what the names say" >&2
      kind="CAPPED: no usable selection"
      # the changed tests, and tests/test_<stem>.py for each changed src/ws/<stem>.py, by name alone
      names="$(git diff --name-only origin/main...HEAD 2>/dev/null || true)"
      while read -r line; do
        case "$line" in
          tests/*test_*.py) [[ -f "$line" ]] && targets+=("$line") ;;
          src/ws/*.py)
            stem="$(basename "$line" .py)"
            [[ -f "tests/test_${stem}.py" ]] && targets+=("tests/test_${stem}.py")
            ;;
        esac
      done <<<"$names"
      targets+=("${smoke[@]}")
      ;;
  esac
  count="${#targets[@]}"
  if [[ "$count" == 0 ]]; then
    targets=("${smoke[@]}")
  fi
  suite+=("${targets[@]}")
  if [[ "$kind" == CAPPED* ]]; then
    suite+=(-x) # the first failure ends the capped run, so the cap never hides one
    # the cap only has to catch a hang, so it grows with the set: 6 s a file, at least 300 s, at most 1800 s
    cap="${WS_PREPUSH_CAP:-}"
    if [[ -n "$cap" && ! "$cap" =~ ^[1-9][0-9]*$ ]]; then
      echo "pre-push: WS_PREPUSH_CAP='$cap' is not a whole number of seconds above 0; using the computed cap" >&2
      cap=""
    fi
    if [[ -z "$cap" ]]; then
      cap=$((${#targets[@]} * 6))
      ((cap < 300)) && cap=300
      ((cap > 1800)) && cap=1800
    fi
    if command -v timeout >/dev/null 2>&1; then
      limit=(timeout "$cap")
    fi
  fi
  echo "pre-push: $kind: ${#targets[@]} test file(s); CI runs the whole suite (WS_PREPUSH_FULL=1 runs it here)" >&2
fi

# the cap sits inside the wrapper: time spent queued behind other runs doesn't count against it
if [[ "${#limit[@]}" != 0 ]]; then
  suite=("${limit[@]}" "${suite[@]}")
fi
if [[ "$auto_wrap" == 1 ]]; then
  # --light for a selected or capped set: the e2e files in it would be guessed as UI (refused in a worktree, never sent
  # to a node). --full for the whole suite, which needs the full class's memory and lock, or light's cap would OOM it.
  # The whole suite uses --node auto: a machine with a spare node runs it there, so a push does not queue behind
  # another full run here (a 45-minute wait was seen). auto never moves a tree with untracked files and falls back to
  # this machine when no node is ready. A selected or capped set stays --node local: it tests the working folder.
  if [[ "$kind" == FULL ]]; then
    wrap=(ws-test --full --node auto --)
  else
    # memory scales with the set: 3G for a small one; 6G with e2e runners in it or past 40 files (103 files with the
    # runners hit 3G and were OOM-killed); never more than 8G
    mem=3G
    if [[ "${#targets[@]}" -gt 40 ]]; then
      mem=6G
    else
      for target in "${targets[@]}"; do
        [[ "$target" == tests/e2e || "$target" == tests/e2e/* ]] && mem=6G
      done
    fi
    wrap=(ws-test --light --mem "$mem" --node local --)
  fi
fi
if [[ "${#wrap[@]}" != 0 ]]; then
  suite=("${wrap[@]}" "${suite[@]}")
fi
echo "pre-push: ${suite[*]}" >&2
rc=0
"${suite[@]}" >&2 || rc=$?
if [[ "$rc" == 124 && "${#limit[@]}" != 0 ]]; then
  echo "pre-push: the capped set hit its ${cap} s cap before it finished, so it is not a pass." >&2
  echo "pre-push: raise it with WS_PREPUSH_CAP=<seconds>, or WS_SKIP_PREPUSH=1 (logged); CI runs the whole suite." >&2
fi
exit "$rc"
