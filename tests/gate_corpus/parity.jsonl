{"id": "parity-ssh-config", "payload": {"kind": "command", "value": "ssh -F ~/.ssh/config host"}, "expect": "allow", "source": "parity", "why": "an ssh config names hosts, not keys; deny_read on ~/.ssh/** has an allow_read carve-out for public keys, the ssh config and known hosts"}
{"id": "parity-listen-http-server", "payload": {"kind": "command", "value": "python3 -m http.server"}, "expect": "ask", "source": "parity", "why": "a listener reachable from other machines needs a person's say-so"}
